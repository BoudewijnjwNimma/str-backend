{
  "manifest_version": 3,
  "name": "Airbnb Yield Calculator",
  "version": "1.1",
  "description": "Bereken het maximale bod op een vakantieverhuurwoning op basis van AirROI data.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Airbnb Yield Calculator"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.idealista.com/*",
        "https://*.fotocasa.es/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
